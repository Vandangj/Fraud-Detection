# =========================
# PYTHON
# =========================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/

ml/models

# Environment variables
.env
.env.*
!.env.example

# Python build files
build/
dist/
*.egg-info/

# =========================
# FRONTEND / NODE / VITE
# =========================

# Node dependencies
node_modules/
frontend/node_modules/

# Vite / frontend build output
frontend/dist/
dist/

# Frontend environment file
frontend/.env

# Keep frontend environment template
!frontend/.env.example

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# IDE / EDITORS
# =========================

# VS Code
.vscode/

# PyCharm
.idea/

# =========================
# JUPYTER
# =========================

.ipynb_checkpoints/

# =========================
# LOGS / TEMP FILES
# =========================

*.log
*.tmp
*.temp
models/retrained/*.tmp
models/retrained/*.reserve

# =========================
# ML MODEL FILES
# =========================

*.joblib

# Allow production model artifacts (all under 4MB, safe for GitHub)
!models/*.pkl
!models/metrics_comparison.json
!models/retrained/*.pkl
!models/retrained/*.json

# =========================
# DATASETS / LARGE DATA
# =========================

# Exclude only large source datasets (>100MB)
data/dataset.csv
dataset.csv

# Keep bundled lightweight dataset for remote retraining fallback
!data/sample_dataset.csv

# =========================
# OS FILES
# =========================

.DS_Store
Thumbs.db
